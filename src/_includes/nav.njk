{% set isHome = page.url == "/" %}
{% set isProfessional = page.url == "/professional/" %}
{% set isBlog = page.url == "/blog/" or page.url.slice(0, 6) == "/blog/" %}
<nav class="nav" aria-label="Primary">
  <a class="nav-brand" href="/">{{ site.name }}</a>
  <div class="nav-links">
    <a href="/"{% if isHome %} aria-current="page"{% endif %}>Home</a>
    <a href="/professional/"{% if isProfessional %} aria-current="page"{% endif %}>Professional</a>
    <a href="/blog/"{% if isBlog %} aria-current="page"{% endif %}>Blog</a>
  </div>
</nav>
