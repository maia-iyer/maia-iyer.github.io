---
layout: layouts/base.njk
permalink: /
---
{% from "macros.njk" import talkLinks, workMedia %}

<section class="hero" aria-labelledby="name">
  <div class="hero-copy">
    <p class="eyebrow">{{ site.role }}</p>
    <h1 id="name" class="name">{{ site.name }}</h1>
    <p class="lede">{{ site.lede }}</p>
    <ul class="social" aria-label="Social links">
      {% for link in site.social %}
      <li>
        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"
          >{{ link.label }}</a
        >
      </li>
      {% endfor %}
    </ul>
  </div>
  <img
    class="portrait"
    src="{{ site.portrait }}"
    alt="{{ site.portraitAlt }}"
    width="176"
    height="176"
  />
</section>

<section id="about" class="section">
  <h2>About</h2>
  <div class="prose">
    {% for page in collections.about %}
    {{ page.templateContent | safe }}
    {% endfor %}
  </div>
</section>

<section id="talks" class="section">
  <h2>Upcoming talks</h2>
  <ul class="list compact">
    {% for item in collections.talks %}
    {% if item.data.status == "upcoming" %}
    <li class="list-item">
      <div class="list-main">
        <div class="talk-heading">
          <span class="talk-title">{{ item.data.title }}</span>
          {{ talkLinks(item) }}
        </div>
        {% if item.data.authors %}
        <span class="authors">{{ item.data.authors }}</span>
        {% endif %}
      </div>
      <span class="dates">{{ item.data.meta }}</span>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
  <p class="section-more">
    <a href="/professional/#talks">Past talks and more →</a>
  </p>
</section>

<section id="works" class="section">
  <h2>Highlighted works</h2>
  <ul class="list works-grid">
    {% for item in collections.works %}
    <li class="list-item">
      <div class="list-heading">
        <span class="org">{{ item.data.kind }}</span>
        <h3>
          {% if item.data.status %}
          <span class="talk-heading">
            <span class="talk-title">{{ item.data.title }}</span>
            {{ talkLinks(item, item.data.embed != false and (item.data.recording | youtubeId)) }}
          </span>
          {% elif item.data.url %}
          <a
            href="{{ item.data.url }}"
            target="_blank"
            rel="noopener noreferrer"
            >{{ item.data.title }}</a
          >
          {% else %}
          {{ item.data.title }}
          {% endif %}
        </h3>
      </div>
      {{ item.templateContent | safe }}
      {{ workMedia(item) }}
    </li>
    {% endfor %}
  </ul>
</section>

<section id="writing" class="section">
  <h2>From the blog</h2>
  {% if collections.blog.length %}
  <ul class="list">
    {% for post in collections.blog %}
    {% if loop.index0 < 2 %}
    <li class="list-item">
      <div class="list-heading">
        <h3>
          <a href="{{ post.url }}">{{ post.data.title }}</a>
        </h3>
        <time class="dates" datetime="{{ post.date.toISOString().slice(0, 10) }}">{{ post.date | readableDate }}</time>
      </div>
      {% if post.data.description %}
      <p>{{ post.data.description }}</p>
      {% endif %}
    </li>
    {% endif %}
    {% endfor %}
  </ul>
  <p class="section-more">
    <a href="/blog/">All posts →</a>
  </p>
  {% else %}
  <p class="prose">No posts yet.</p>
  {% endif %}
</section>
